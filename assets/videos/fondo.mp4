<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Mi sitio con video de fondo</title>
  <style>
    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
    }
    .video-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
    }
    .contenido {
      position: relative;
      z-index: 1;
      color: white;
      text-align: center;
      margin-top: 20%;
      font-family: Arial, sans-serif;
    }
  </style>
</head>
<body>
  <!-- Video de fondo -->
  <video autoplay loop muted playsinline class="video-background">
    <source src="assets/videos/fondo.mp4" type="video/mp4">
  </video>

  <!-- Contenido encima -->
  <div class="contenido">
    <h1>Bienvenido a mi sitio</h1>
    <p>Este es un fondo animado con video</p>
  </div>
</body>
</html>
